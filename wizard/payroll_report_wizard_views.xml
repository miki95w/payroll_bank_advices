<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payroll Report Wizard Form View -->
    <record id="view_payroll_report_wizard_form" model="ir.ui.view">
        <field name="name">payroll.report.wizard.form</field>
        <field name="model">payroll.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Payroll Report">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="report_title" readonly="0" placeholder="Payroll Report"/></h2>
                        <p class="text-muted">
                            Generate comprehensive Salary, Allowance, Deduction, Overtime &amp; Absent reports in Excel (.xlsx) or PDF format.
                        </p>
                    </div>

                    <group>
                        <group string="Report Category &amp; Specific Selection">
                            <field name="report_category" widget="radio"/>

                            <!-- Specific Allowance Picker -->
                            <field name="allowance_rule_ids"
                                   widget="many2many_tags"
                                   invisible="report_category != 'allowance'"
                                   options="{'no_create': True}"
                                   placeholder="Pick specific allowances (Leave empty for All Allowances)"/>

                            <!-- Specific Deduction Picker -->
                            <field name="deduction_rule_ids"
                                   widget="many2many_tags"
                                   invisible="report_category != 'deduction'"
                                   options="{'no_create': True}"
                                   placeholder="Pick specific deductions e.g. Oil Deduction, Floor Deduction (Leave empty for Oil Deduction)"/>

                            <!-- Attendance Sub-Options -->
                            <field name="attendance_sub_type"
                                   widget="radio"
                                   invisible="report_category != 'attendance'"/>
                            
                            <div class="o_row" colspan="2" invisible="report_category == 'all'">
                                <span class="fw-bold me-2">Ethiopian Period:</span>
                                <field name="ethiopian_month" class="oe_inline me-2"/>
                                <field name="ethiopian_year" class="oe_inline" placeholder="Year e.g. 2019"/>
                            </div>
                        </group>

                        <group string="Period &amp; Source">
                            <field name="filter_by" widget="radio"/>
                            <field name="payslip_run_id"
                                   invisible="filter_by != 'batch'"
                                   required="filter_by == 'batch'"
                                   options="{'no_create': True}"/>
                            <label for="date_from" string="Period" invisible="filter_by != 'date'"/>
                            <div class="d-flex gap-2 align-items-center" invisible="filter_by != 'date'">
                                <field name="date_from" required="filter_by == 'date'"/>
                                <span>to</span>
                                <field name="date_to" required="filter_by == 'date'"/>
                            </div>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="only_with_values" invisible="report_category == 'all'"/>
                        </group>
                    </group>

                    <group string="Filters &amp; Options">
                        <group>
                            <field name="department_ids" widget="many2many_tags" placeholder="All Departments"/>
                            <field name="employee_ids" widget="many2many_tags" placeholder="All Employees"/>
                        </group>
                        <group>
                            <field name="bank_id" options="{'no_quick_create': True}" placeholder="Select Bank (All if empty)"/>
                            <field name="bank_name" placeholder="e.g. CBE, Dashen (All if empty)"/>
                            <field name="separate_sheets_by_bank" invisible="report_category != 'all'"/>
                        </group>
                    </group>

                    <group string="Approval Signatures (Footer)" invisible="report_category == 'all'">
                        <group>
                            <field name="prepared_by" placeholder="e.g. Payroll Officer Name"/>
                            <field name="checked_by" placeholder="e.g. Finance Specialist Name"/>
                        </group>
                        <group>
                            <field name="verified_by" placeholder="e.g. HR / Finance Manager Name"/>
                            <field name="approved_by" placeholder="e.g. General Manager Name"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_xlsx"
                            string="Download Excel Report"
                            type="object"
                            class="btn-primary"
                            icon="fa-file-excel-o"/>
                    <button name="action_generate_pdf"
                            string="Print PDF Summary"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-pdf-o"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window Action: Open Payroll Report Wizard -->
    <record id="action_payroll_report_wizard" model="ir.actions.act_window">
        <field name="name">Payroll Report</field>
        <field name="res_model">payroll.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item: Placed inside Payroll Reporting Menu -->
    <menuitem
        id="menu_payroll_report"
        name="Payroll Report"
        parent="hr_payroll.menu_hr_payroll_report"
        action="action_payroll_report_wizard"
        sequence="30"/>

</odoo>
