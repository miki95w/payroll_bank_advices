<?xml version="1.0" encoding="utf-8"?>
<odoo>



 
    <!-- Payslip List View: Print Bank Advice in multi-selection header -->
    <record id="hr_payslip_view_tree_inherit_bank_advice" model="ir.ui.view">
        <field name="name">hr.payslip.tree.inherit.bank.advice</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button
                    name="action_print_bank_advice"
                    string="Print Bank Advice"
                    type="object"
                    class="btn-primary"
                    icon="fa-university"
                    groups="hr_payroll.group_hr_payroll_user"
                />
                <button
                    name="action_open_payroll_report"
                    string="Payroll Report (Excel)"
                    type="object"
                    class="btn-secondary"
                    icon="fa-file-excel-o"
                    groups="hr_payroll.group_hr_payroll_user"
                />
            </xpath>
        </field>
    </record>

    <!-- Payslip Form View: Print Bank Advice in header -->
    <record id="hr_payslip_view_form_inherit_bank_advice" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.bank.advice</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_print_bank_advice"
                    string="Print Bank Advice"
                    type="object"
                    class="btn-secondary"
                    icon="fa-university"
                    groups="hr_payroll.group_hr_payroll_user"
                    invisible="state == 'cancel'"
                />
                <button
                    name="action_open_payroll_report"
                    string="Payroll Report (Excel)"
                    type="object"
                    class="btn-secondary"
                    icon="fa-file-excel-o"
                    groups="hr_payroll.group_hr_payroll_user"
                    invisible="state == 'cancel'"
                />
            </xpath>
        </field>
    </record>
</odoo>
